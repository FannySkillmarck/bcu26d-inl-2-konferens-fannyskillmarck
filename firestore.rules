rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPassId(passId) {
      return passId is string && passId.size() <= 32 && passId.matches('^SF27-[A-F0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'savedTalkIds',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'savedTalkIds',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.savedTalkIds is list && data.savedTalkIds.size() <= 12 &&
        (data.savedTalkIds.size() == 0 || (data.savedTalkIds[0] is string && data.savedTalkIds[0].size() <= 128)) &&
        data.preferredLanguage is string && data.preferredLanguage.size() <= 8 &&
        data.preferredLanguage in ['sv', 'en', 'zh'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTicketRegistration(data) {
      return data.keys().hasAll([
          'registrationId',
          'userId',
          'tierId',
          'tierName',
          'quantity',
          'fullName',
          'email',
          'dietary',
          'passId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'registrationId',
          'userId',
          'tierId',
          'tierName',
          'quantity',
          'fullName',
          'email',
          'dietary',
          'passId',
          'web3Wallet',
          'web3ChainId',
          'web3Signature',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.registrationId) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.tierId is string && data.tierId.size() <= 32 &&
        data.tierId in ['student', 'ordinarie', 'after-work', 'utstallare'] &&
        data.tierName is string && data.tierName.size() >= 1 && data.tierName.size() <= 80 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 5 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.dietary is string && data.dietary.size() <= 200 &&
        isValidPassId(data.passId) &&
        (!('web3Wallet' in data) || (data.web3Wallet is string && data.web3Wallet.size() <= 64)) &&
        (!('web3ChainId' in data) || (data.web3ChainId is string && data.web3ChainId.size() <= 32)) &&
        (!('web3Signature' in data) || (data.web3Signature is string && data.web3Signature.size() <= 256)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCheckInEntry(data) {
      return data.keys().hasAll([
          'passId',
          'scannerUid',
          'holder',
          'tier',
          'qty',
          'web3Verified',
          'checkedInAtIso',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'passId',
          'scannerUid',
          'holder',
          'tier',
          'qty',
          'web3Verified',
          'wallet',
          'checkedInAtIso',
          'createdAt'
        ]) &&
        isValidPassId(data.passId) &&
        isValidId(data.scannerUid) &&
        data.scannerUid == request.auth.uid &&
        data.holder is string && data.holder.size() >= 1 && data.holder.size() <= 120 &&
        data.tier is string && data.tier.size() >= 1 && data.tier.size() <= 80 &&
        data.qty is int && data.qty >= 1 && data.qty <= 10 &&
        data.web3Verified is bool &&
        (!('wallet' in data) || (data.wallet is string && data.wallet.size() <= 64)) &&
        data.checkedInAtIso is string && data.checkedInAtIso.size() >= 10 && data.checkedInAtIso.size() <= 40 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['savedTalkIds', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['preferredLanguage', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'preferredLanguage', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      match /registrations/{registrationId} {
        allow get: if isValidId(userId) && isValidId(registrationId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId) &&
          isValidId(registrationId) &&
          isOwner(userId) &&
          isValidTicketRegistration(incoming()) &&
          incoming().registrationId == registrationId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isValidId(userId) &&
          isValidId(registrationId) &&
          isOwner(userId) &&
          isValidTicketRegistration(incoming()) &&
          incoming().registrationId == existing().registrationId &&
          incoming().userId == existing().userId &&
          incoming().passId == existing().passId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'web3Wallet',
            'web3ChainId',
            'web3Signature',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(registrationId) && isOwner(userId);
      }

      match /checkIns/{passId} {
        allow get: if isValidId(userId) && isValidPassId(passId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.scannerUid == request.auth.uid;

        allow create: if isValidId(userId) &&
          isValidPassId(passId) &&
          isOwner(userId) &&
          isValidCheckInEntry(incoming()) &&
          incoming().passId == passId &&
          incoming().scannerUid == userId &&
          incoming().createdAt == request.time &&
          hasValidParentUser(userId);

        allow update: if false;
        allow delete: if isValidId(userId) && isValidPassId(passId) && isOwner(userId);
      }
    }
  }
}
